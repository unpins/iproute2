tc names ematch kinds through ematch_map, read from /etc/iproute2 and then
/usr/share/iproute2. Neither exists on a host without an iproute2 package, and
then every ematch fails: `basic match 'cmp(…)'` stops with "Unable to find
ematch", and `tc filter show` cannot name one. Fall back to upstream's own
table, compiled in; the files on disk keep precedence.

--- a/tc/m_ematch.c
+++ b/tc/m_ematch.c
@@ -124,6 +124,32 @@
 	return err;
 }
 
+/* etc/iproute2/ematch_map, for hosts that install neither copy */
+static const struct { int id; const char *name; } builtin_ematch_map[] = {
+	{ 1, "cmp" }, { 2, "nbyte" }, { 3, "u32" }, { 4, "meta" },
+	{ 7, "canid" }, { 8, "ipset" }, { 9, "ipt" },
+};
+
+static int lookup_builtin_map(__u16 num, char *dst, int len)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(builtin_ematch_map); i++)
+		if (builtin_ematch_map[i].id == num) {
+			strncpy(dst, builtin_ematch_map[i].name, len - 1);
+			return 0;
+		}
+	return -ENOENT;
+}
+
+static int lookup_builtin_map_id(const char *kind, int *dst)
+{
+	for (size_t i = 0; i < ARRAY_SIZE(builtin_ematch_map); i++)
+		if (!strcasecmp(builtin_ematch_map[i].name, kind)) {
+			*dst = builtin_ematch_map[i].id;
+			return 0;
+		}
+	return -ENOENT;
+}
+
 static struct ematch_util *get_ematch_kind(char *kind)
 {
 	static void *body;
@@ -166,6 +192,8 @@
 	ret = lookup_map(kind, name, sizeof(name), EMATCH_MAP_ETC);
 	if (ret == -ENOENT)
 		ret = lookup_map(kind, name, sizeof(name), EMATCH_MAP_USR);
+	if (ret == -ENOENT)
+		ret = lookup_builtin_map(kind, name, sizeof(name));
 	if (ret < 0)
 		return NULL;
 
@@ -235,6 +263,8 @@
 			err = lookup_map_id(buf, &num, EMATCH_MAP_ETC);
 			if (err == -ENOENT)
 				err = lookup_map_id(buf, &num, EMATCH_MAP_USR);
+			if (err == -ENOENT)
+				err = lookup_builtin_map_id(buf, &num);
